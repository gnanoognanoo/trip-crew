# TripCrew Pay - Payment Provider Configuration
# Set PAYMENT_PROVIDER to 'sandbox' (default) or 'razorpay'
PAYMENT_PROVIDER=sandbox

# ==============================================================================
# RAZORPAY CONFIGURATION
# Sign up at https://dashboard.razorpay.com/ to obtain API credentials.
# These credentials must ONLY be loaded in the trusted backend server/environment,
# NEVER inside Flutter source code or client builds.
# ==============================================================================
RAZORPAY_ENVIRONMENT=test
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Base URL of the trusted TripCrew backend service
TRIPCREW_BACKEND_URL=https://trip-creww-production.up.railway.app
