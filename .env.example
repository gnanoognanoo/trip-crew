# TripCrew Pay - Payment Provider Configuration
# Set PAYMENT_PROVIDER to 'sandbox' (default) or 'setu'
PAYMENT_PROVIDER=sandbox

# ==============================================================================
# SETU UPI SANDBOX / UAT CONFIGURATION
# Sign up at https://bridge.setu.co/ to obtain sandbox credentials.
# These credentials must ONLY be loaded in the trusted backend server/environment,
# NEVER inside Flutter source code or client builds.
# ==============================================================================
SETU_ENVIRONMENT=uat
SETU_CLIENT_ID=your_setu_client_id_here
SETU_CLIENT_SECRET=your_setu_client_secret_here
SETU_PRODUCT_INSTANCE_ID=your_setu_product_instance_id_here
SETU_WEBHOOK_SECRET=your_setu_webhook_secret_here

# Optional: Base URL of the trusted TripCrew backend service
TRIPCREW_BACKEND_URL=http://localhost:8080
